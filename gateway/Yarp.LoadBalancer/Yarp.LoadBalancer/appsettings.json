{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Clusters": {
      "nova": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:59259"
          },
          "backup": {
            "Address": "http://localhost:59259"
          }
        },       
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Path": "/health",
            "Timeout": "00:00:05",
            "Interval": "00:00:10",
            "ExpectedStatusCodes": [ 200 ]
          }
        }
      },
      "glaxy": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:50001"
          },
          "backup": {
            "Address": "http://localhost:59259"
          }
        },
        "RouteId": "TpRoute",
        "HealthCheck": {
          "Active": {
            "Enabled": true,
            "Path": "/health",
            "Timeout": "00:00:05",
            "Interval": "00:00:10",
            "ExpectedStatusCodes": [ 200 ]
          }
        }
      }
    },
    "Routes": {
      "TpRoute": {
        "ClusterId": "nova",
        "Match": {
          "Path": "{**catch-all}"
        }
      }     
    }
  }
}
