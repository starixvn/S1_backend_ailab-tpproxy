{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Clusters": {
      "nova": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:59259"
          },
          "backup": {
            "Address": "http://localhost:59259"
          }
        }
      },
      "glaxy": {
        "Destinations": {
          "primary": {
            "Address": "http://localhost:59259"
          },
          "backup": {
            "Address": "http://localhost:59259"
          }
        }
      }
    },
    "Routes": {
      "TpRoute": {
        "ClusterId": "glaxy",
        "Match": {
          "Path": "{**catch-all}"
        }
      }     
    }
  }
}
